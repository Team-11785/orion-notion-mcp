{
  "name": "orion-notion-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server that lets the whole team use Claude with the team's Notion workspace",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test dist-test/test/*.test.js",
    "gen-key": "node scripts/gen-key.mjs",
    "team-key": "node scripts/team-key.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
